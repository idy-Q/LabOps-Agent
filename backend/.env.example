# LabOps-Agent 环境配置示例模板
# 复制为 .env 文件后生效：copy .env.example .env

# 服务端口与基础信息
APP_NAME=LabOps-Agent
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 跨域设置
CORS_ORIGINS=*

# 数据库配置 (默认嵌入式 SQLite)
# DATABASE_URL=sqlite:///app/data/labops.db

# 大语言模型多级容灾与 ReAct 引擎配置
# 默认为空，系统处于 auto 模式下会自动使用内置确定性 Mock 调度大脑（保证断网离线与答辩免死金牌演示）
#
# 1. 主通道 (Primary Channel，默认 DeepSeek)
# 用户在获取到 DeepSeek API Key 后填入，即可激活主通道真实推理：
PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://api.deepseek.com/v1
PRIMARY_MODEL_NAME=deepseek-chat

# （向后兼容：若仅配置 OPENAI_API_KEY，系统也会自动作为主通道使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# 2. 备用通道 (Fallback Channel，默认阿里通义千问 Qwen)
# 当主通道遭遇云端服务器宕机、超时或限流时，系统将无缝自动切换至备用通道继续推理：
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FALLBACK_MODEL_NAME=qwen3.8-flash

# 3. HTTP 快速失败 (Fail-Fast) 熔断超时设置 (秒)
LLM_CONNECT_TIMEOUT=3.0
LLM_READ_TIMEOUT=15.0

# Agent 运行模式：auto (无 Key 自动使用本地 Mock，有 Key 自动使用商业模型), mock (强制本地 Mock), real (强制使用真实模型)
AGENT_MOCK_MODE=auto
REACT_MAX_STEPS=6
