# LabOps-Agent 环境配置示例模板
# 复制为 .env 文件后生效：copy .env.example .env

# 服务端口与基础信息
APP_NAME=LabOps-Agent
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 跨域设置
CORS_ORIGINS=*

# 数据库配置 (默认嵌入式 SQLite)
# DATABASE_URL=sqlite:///app/data/labops.db

# 大语言模型与 ReAct 引擎配置
# 默认为空，系统处于 auto 模式下会自动使用内置确定性 Mock 调度大脑（保证离线与免死金牌演示）
# 用户在获取到 DeepSeek 或 OpenAI 的 API Key 后，填入下方即可无缝一键切换至真实商业大模型：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# Agent 运行模式：auto (无 Key 自动 Mock，有 Key 自动使用商业模型), mock (强制本地 Mock), real (强制使用真实模型)
AGENT_MOCK_MODE=auto
REACT_MAX_STEPS=6
